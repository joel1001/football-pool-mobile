{
  "files.associations": {
    "*.storybook": "typescript"
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.rnstorybook/storybook.requires.ts": true,
    "**/storybook-static": true
  },
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "i18n-ally.localesPaths": [
    "i18n",
    "i18n/locales"
  ]
}
